# OpenClaw Docker Environment Configuration
# Copy this file to .env.openclaw and customize as needed

# Data directory for OpenClaw (mounted into container as /root/.openclaw)
OPENCLAW_DATA_DIR=./openclaw_docker_data

# Gateway port (default: 18789). Leave empty for auto-selection.
GATEWAY_PORT=18789

# Docker image for the gateway
GATEWAY_IMAGE=openclaw/pod:latest

# Rebuild images before starting (true/false)
FRESH_BUILD=false